<?xml version="1.0" encoding="UTF-8"?>
<!--
  参考实现，不是发布物：不推 Maven 仓库、不跟 einfach-agent-rust 的版本号
  （docs/ROADMAP.md 决策 13）。groupId/artifactId 拷走之后随便改成你自己的。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>agent-gateway</artifactId>
  <version>0.0.0-reference</version>
  <packaging>jar</packaging>

  <name>agent-gateway</name>
  <description>
    einfach-agent-rust 的 Java WebFlux 参考网关（examples/java-gateway）。
    拷走改，别当依赖：不发 Maven、不承诺 Spring Boot 2/3 双兼容、不跟版
    （docs/ROADMAP.md 决策 13）。本参考实现以 Java 17 为编译目标；当前
    mvn -q package 已在本仓库通过。
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!--
      唯一一个 starter。此参考实现选 WebFlux + ServerSentEvent 生成浏览器
      SSE；Rust 侧已改为有界长轮询，不再要求 Java 代理一条上游 SSE。Spring
      MVC 也可以移植这份协议，但必须以异步方式处理浏览器流。不加别的
      starter：拷走代码的人应能一眼看完全部依赖来自哪里。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
