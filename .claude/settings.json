{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PROJECT_DIR:-.}/scripts/check-invariants.sh\"; [ -x \"$s\" ] && \"$s\" || exit 0",
            "timeout": 15,
            "statusMessage": "检查架构红线"
          }
        ]
      }
    ]
  }
}
